# Copy this file to .env and fill in real values before running the app.
# See src/config/env.ts for the full validation schema — the app refuses to start
# if a required variable is missing or malformed.

NODE_ENV=development
PORT=5000
# Comma-separated list of origins allowed to call this API with credentials.
ALLOWED_ORIGINS=http://localhost:5173

# ── Database (MongoDB Atlas) ─────────────────────────────────────────────────
# MONGO_URL is required and is the only var Mongoose reads.
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>
DATABASE_URL=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate strong random secrets, e.g.: openssl rand -hex 32
JWT_SECRET=
REFRESH_TOKEN_SECRET=

# ── System alert recipient (health monitor "[System Alert]" emails) ───────────
EMAIL_USER=

# ── Cloudinary (product/category/banner image storage) ────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Razorpay — shop owner e-commerce checkout ──────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── MSG91 (mobile OTP widget) ───────────────────────────────────────────────────
MSG91_AUTH_KEY=
MSG91_TOKEN_AUTH=
MSG91_WIDGET_ID=

# ── MSG91 Email API (transactional email — OTP, order confirmation, order
# status, system alerts) — replaces the old SMTP transport. MSG91_EMAIL_DOMAIN
# must be verified in MSG91's Email dashboard; MSG91_EMAIL_FROM must be an
# address on that domain. Each MSG91_TEMPLATE_* is a template id created in
# MSG91's dashboard (Email > Templates) — see src/config/mailer.ts for the
# {{variable}} placeholders each one needs. Leave blank and email sending
# no-ops with a warning log instead of failing requests.
MSG91_EMAIL_DOMAIN=
MSG91_EMAIL_FROM=
MSG91_EMAIL_FROM_NAME=blueprint_crm
MSG91_TEMPLATE_OTP=
MSG91_TEMPLATE_ORDER_CONFIRMATION=
MSG91_TEMPLATE_ORDER_STATUS=
MSG91_TEMPLATE_HEALTH_ALERT=

# ── Shipping ──────────────────────────────────────────────────────────────────
WAREHOUSE_LAT=9.9312
WAREHOUSE_LNG=76.2673

# ── Background job / inventory alert config ────────────────────────────────────
LOW_STOCK_THRESHOLD=5

# ── Backup / disaster recovery ─────────────────────────────────────────────────
BACKUP_DIR=./backups
BACKUP_RETENTION_COUNT=14

# ── CSRF ──────────────────────────────────────────────────────────────────────
# Generate a strong random secret, e.g.: openssl rand -hex 32
CSRF_SECRET=

# ── Archival job retention windows (optional — sensible defaults if unset) ────
AUDIT_LOG_RETENTION_MONTHS=6
ORDER_RETENTION_YEARS=2
